# ==============================================================================
# PRODUCTION ON VPS (/opt/artist-shop/.env.production)
# Copy this file to /opt/artist-shop/.env.production, fill in real values and
# run `chmod 600` on it. NEVER commit the filled file.
#
# Key names must stay in sync with the application configuration
# (internal/share/config/config.go) and with docker-compose.prod.yml.
#
# Image references are NOT set here: the CD workflow pins them by digest in
# /opt/artist-shop/.env.deploy (API_IMAGE=...@sha256:...).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME
# ------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
TZ=Asia/Ho_Chi_Minh
# production skips loading .env files; every value must come from this env_file
# (via compose) or from the real process environment.
HTTP_ADDR=:8080
SHOP_TIMEZONE=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 2. NGINX / DOMAIN
# ------------------------------------------------------------------------------
API_DOMAIN=api.sumichi.hycat.online
HTTP_PORT=8083
HTTPS_PORT=8445
TLS_DIR=/opt/artist-shop-tls

# ------------------------------------------------------------------------------
# 3. POSTGRES (compose bootstrap; only applied when the volume is first created)
# ------------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_DB=artist_shop
POSTGRES_PASSWORD=replace_with_a_long_random_password
# Generate with `openssl rand -hex 32`: the password is embedded in DATABASE_URL,
# so base64 characters such as /, + and = would break the URL.
# DATABASE_URL is set by docker-compose.prod.yml to the db service hostname.

# ------------------------------------------------------------------------------
# 4. REDIS
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_a_long_random_redis_password
REDIS_DB=0
# REDIS_ADDR is set by docker-compose.prod.yml to redis:6379.

# ------------------------------------------------------------------------------
# 5. CORS & TRUSTED PROXIES
# ------------------------------------------------------------------------------
# Comma-separated allowlist. Never use "*" in production.
CORS_ALLOWED_ORIGINS=https://sumichi.hycat.online
# CIDRs allowed to set X-Forwarded-For. The compose network uses private
# addresses; narrow this if the deployment uses a fixed subnet.
HTTP_TRUSTED_PROXIES=172.16.0.0/12

# ------------------------------------------------------------------------------
# 6. AUTH
# ------------------------------------------------------------------------------
# HS256 signing key; the API refuses to start when shorter than 32 bytes.
JWT_SECRET=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1080h

# ------------------------------------------------------------------------------
# 7. REQUEST LIMITS & MIGRATIONS
# ------------------------------------------------------------------------------
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
MAX_BODY_BYTES=12582912
AUDIT_QUEUE_SIZE=1024
AUDIT_MAX_RETRIES=5
# The CD workflow runs `migrate up` before rollout; the API must not migrate.
MIGRATIONS_AUTO_APPLY=false
MIGRATIONS_LOCK_TIMEOUT=30s
# The interactive API reference exposes every endpoint; keep it off.
SWAGGER_ENABLED=false

# ------------------------------------------------------------------------------
# 8. EMAIL (SMTP)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST empty to log messages instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sumichi.hycat.online
ADMIN_EMAIL=replace_with_the_shop_operator_email

# ------------------------------------------------------------------------------
# 9. MEDIA (Cloudinary)
# ------------------------------------------------------------------------------
# Empty MEDIA_* values are supported: they disable image upload only.
MEDIA_CLOUD_NAME=
MEDIA_API_KEY=
MEDIA_API_SECRET=
MEDIA_FOLDER=artist-shop

# ------------------------------------------------------------------------------
# 10. PAYMENT (PayOS)
# ------------------------------------------------------------------------------
# Empty PAYOS_* values are supported: payments run with a log-only provider.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYMENT_RETURN_URL=https://sumichi.hycat.online/payment/success
PAYMENT_CANCEL_URL=https://sumichi.hycat.online/payment/cancel
