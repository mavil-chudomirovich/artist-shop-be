# Copy to .env for local development: `make env` (or `cp .env.example .env`).
# Never commit real secrets: .env is git-ignored.
#
# The same file works for `make run` (Go on the host) and `make up` (Docker).
# docker-compose.yml overrides DATABASE_URL / REDIS_ADDR to the container
# hostnames, so the host-oriented values below are only used outside Docker.

# --- Runtime ---------------------------------------------------------------
# development | staging | production
APP_ENV=development

# --- HTTP server -----------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Empty means the
# header is ignored and the TCP peer address is used (safe default).
HTTP_TRUSTED_PROXIES=

# --- PostgreSQL ------------------------------------------------------------
# Use `db` instead of `localhost` when running inside Docker.
DATABASE_URL=postgres://app:app@localhost:5432/artist_shop?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT=5s

# --- Logging: debug | info | warn | error ----------------------------------
LOG_LEVEL=info

# --- CORS: comma-separated origin allowlist --------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting (in-process) --------------------------------------------
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# --- Request handling ------------------------------------------------------
# Pipeline-wide early refusal ceiling (4 MiB). It runs before routing, so a route
# cannot lift it: it must stay above every route-specific limit. The avatar route
# caps an image at 2 MB (+ 64 KB for the multipart envelope), so do NOT lower this
# to 2 MB or below — a legitimate upload would be refused before the route could
# apply its own rule. The real protections are the rate limiter, the read ceilings
# and the per-field rules.
MAX_BODY_BYTES=4194304

# --- Swagger UI ------------------------------------------------------------
# Interactive API reference at /swagger. Development/staging only: it exposes
# the whole endpoint surface, so production must leave this false. The generated
# spec under docs/swagger stays available for offline review either way.
SWAGGER_ENABLED=true

# --- Audit writer ----------------------------------------------------------
AUDIT_QUEUE_SIZE=1024
AUDIT_MAX_RETRIES=5

# --- Redis (OTP storage + access-token blacklist) -------------------------
# Use `redis:6379` instead of `localhost:6379` when running inside Docker.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis-dev-password
REDIS_DB=0

# --- Auth: tokens ----------------------------------------------------------
# Must be at least 32 bytes; the API refuses to start otherwise.
JWT_SECRET=change-me-to-at-least-32-bytes-long!!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1080h

# --- Auth: email OTP -------------------------------------------------------
OTP_TTL=15m
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_TTL=60s
OTP_RESEND_COOLDOWN=60s

# --- Auth: password reset --------------------------------------------------
PASSWORD_RESET_TTL=30m

# --- Auth: rate limiting and lockout ---------------------------------------
AUTH_LOGIN_RATE_PER_MINUTE=10
AUTH_FLOW_RATE_PER_MINUTE=5
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_LOCKOUT_TTL=15m

# --- Auth: email delivery --------------------------------------------------
# Leave SMTP_HOST empty to log emails instead of sending them.
# With `make up-tools`, Mailpit listens on 1025 so use SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@artist-shop.local

# --- Auth: admin seed (used only by cmd/seed / `make seed`) ----------------
ADMIN_EMAIL=admin@artist-shop.local
ADMIN_PASSWORD=Admin@12345

# --- Media: avatar upload (Cloudinary) -------------------------------------
# Placeholders only — take the real values from the Cloudinary dashboard and put
# them in .env (git-ignored) or your platform's secret store. Never commit real
# credentials and never pass them on a command line.
# CLOUD_NAME  the cloud name shown in the dashboard
# API_KEY     the API key
# API_SECRET  the API secret (only the upload preset needs it)
MEDIA_CLOUD_NAME=
MEDIA_API_KEY=
MEDIA_API_SECRET=
# Folder inside the cloud account that receives the uploaded avatars.
MEDIA_FOLDER=artist-shop

# Leaving MEDIA_* empty is a supported state, not a misconfiguration: it disables
# avatar upload and nothing else. POST /api/v1/users/me/avatar then answers
# 503 USER_MEDIA_UNAVAILABLE and the profile is unchanged, so the customer can
# retry later; reading and updating the profile, and every address endpoint, keep
# working because none of them call the media service.

# --- User module: rate limiting --------------------------------------------
# Two separate buckets, both per IP. A client hammering avatar upload cannot
# spend the address-write budget, and vice versa. Both still add up against the
# global RATE_LIMIT_RPS net.
USER_AVATAR_UPLOAD_RATE_PER_HOUR=10
USER_ADDRESS_WRITE_RATE_PER_MINUTE=30

# --- Migrations ------------------------------------------------------------
MIGRATIONS_AUTO_APPLY=true
MIGRATIONS_LOCK_TIMEOUT=30s
